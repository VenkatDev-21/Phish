# ---------------------------------------------------------------------------
# PhishGuard configuration template
#
# Copy this file to `.env` for local development:  Copy-Item .env.example .env
# `.env` is ignored by Git. Never put real keys in this template.
# ---------------------------------------------------------------------------

# Flask session + CSRF signing key. Required outside local development.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Local development defaults: HOST=127.0.0.1, PORT=5000.
# HOST=127.0.0.1
# PORT=5000

# Where the SQLite database and temporary uploads live.
# Local default is the project folder; a hosted deployment should use /tmp or a
# mounted disk instead of the source tree.
# PHISHGUARD_DATA_DIR=

# Upload ceilings in bytes. Local default is 5 GiB, hosted default is 100 MiB.
# MAX_UPLOAD_BYTES=5368709120
# MAX_EMAIL_REQUEST_BYTES=67108864

# Shared passcode for /dashboard, /history, /authentication and the dashboard
# APIs. Leave empty to disable the gate (the scanners are always open).
# PHISHGUARD_ACCESS_CODE=

# Comma-separated browser origins allowed to call /api/v1. "*" allows any.
# PHISHGUARD_ALLOWED_ORIGINS=

# Set to 0 to disable the in-process rate limiter (not recommended when hosted).
# PHISHGUARD_RATE_LIMIT=1

# Set to 0 to refuse third-party file submissions even when a user opts in.
# PHISHGUARD_EXTERNAL_SUBMISSIONS=1

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

# ClamAV. Install from https://www.clamav.net/downloads and run freshclam once.
# CLAMSCAN_PATH="C:\Program Files\ClamAV\clamscan.exe"
# CLAMAV_DATABASE_DIR="C:\Users\<you>\AppData\Local\PhishGuard\clamav-db"

# Third-party scanners. Create these in your own vendor accounts; files are
# only sent when the per-scan consent box is checked.
# VT_API_KEY=
# OPSWAT_API_KEY=
# OPSWAT_MAX_UPLOAD_BYTES=
